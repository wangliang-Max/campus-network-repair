    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "orderId",
      "value": "12"
    },
    {
      "key": "deviceId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "5"
    }
