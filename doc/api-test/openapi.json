              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultRepairOrderDetailVO"
                }
              }
            }
          }
        }
      }
    },
    "/api/repair-orders/{id}/finish": {
      "post": {
        "tags": [
          "报修单管理"
        ],
        "summary": "修复完成：修复中 -> 待确认",
