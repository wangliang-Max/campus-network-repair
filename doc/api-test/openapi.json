                  "$ref": "#/components/schemas/ResultLoginVO"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats/overview": {
      "get": {
        "tags": [
          "统计报表"
        ],
        "summary": "统计概览：总量、未关闭数、平均修复时长、按机房/状态分组",
        "operationId": "overview",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultStatsOverviewVO"
                }
              }
            }
          }
        }
      }
    },
    "/api/repair-orders/{id}": {
      "get": {
        "tags": [
          "报修单管理"
        ],
        "summary": "报修单详情（含状态轨迹、处理记录、验收记录、可执行动作）",
        "operationId": "detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultRepairOrderDetailVO"
                }
              }
            }
          }
        }
      }
    },
    "/api/repair-orders/my": {
      "get": {
        "tags": [
          "报修单管理"
        ],
        "summary": "我的报修列表",
        "operationId": "my",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultListRepairOrderVO"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "健康检查"
        ],
        "summary": "健康检查",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultMapStringString"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/rooms": {
      "get": {
        "tags": [
          "机房设备管理"
        ],
        "summary": "机房列表（用于筛选项）",
        "operationId": "rooms",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultListString"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeviceSaveDTO": {
        "required": [
          "deviceCode",
          "deviceName",
          "roomName"
        ],
        "type": "object",
        "properties": {
          "deviceCode": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string",
            "description": "设备编号，唯一"
          },
          "deviceName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "roomName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "status": {
            "pattern": "NORMAL|FAULT|REPAIRING",
            "type": "string",
            "description": "设备状态，默认 NORMAL"
          },
          "remark": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          }
        },
        "description": "设备新增或修改请求"
      },
      "DeviceVO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "deviceCode": {
            "type": "string"
          },
          "deviceName": {
            "type": "string"
          },
          "roomName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "statusLabel": {
            "type": "string"
          },
          "remark": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "设备信息"
      },
      "ResultDeviceVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/DeviceVO"
          }
        }
      },
      "RepairOrderCreateDTO": {
        "required": [
          "deviceId",
          "faultDesc"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "integer",
            "description": "故障设备ID",
            "format": "int64"
          },
          "faultDesc": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "故障描述"
          },
          "priority": {
            "pattern": "NORMAL|URGENT",
            "type": "string",
            "description": "优先级，默认 NORMAL"
          }
        },
        "description": "提交报修单请求"
      },
      "RepairOrderVO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "报修单ID",
            "format": "int64"
          },
          "orderNo": {
            "type": "string",
            "description": "报修单号"
          },
          "reporterId": {
            "type": "integer",
            "description": "报障人ID",
            "format": "int64"
          },
          "reporterName": {
            "type": "string",
            "description": "报障人姓名（关联 sys_user）"
          },
          "deviceId": {
            "type": "integer",
            "description": "设备ID",
            "format": "int64"
          },
          "deviceName": {
            "type": "string",
            "description": "设备名称（关联 device）"
          },
          "roomName": {
            "type": "string",
            "description": "所在机房"
          },
          "faultDesc": {
            "type": "string",
            "description": "故障描述"
          },
          "priority": {
            "type": "string",
            "description": "优先级"
          },
          "status": {
            "type": "string",
            "description": "单据状态"
          },
          "statusLabel": {
            "type": "string",
            "description": "单据状态中文名"
          },
          "priorityLabel": {
            "type": "string",
            "description": "优先级中文名"
          },
          "createdAt": {
            "type": "string",
            "description": "提交时间",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "最后更新时间",
            "format": "date-time"
          }
        },
        "description": "报修单视图对象"
      },
      "ResultRepairOrderVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/RepairOrderVO"
          }
        }
      },
      "SupplementDTO": {
        "required": [
          "faultDesc"
        ],
        "type": "object",
        "properties": {
          "faultDesc": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "补充后的故障描述"
          }
        },
        "description": "补充故障信息请求"
      },
      "ConfirmRecordVO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "confirmBy": {
            "type": "integer",
            "format": "int64"
          },
          "confirmName": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "comment": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "验收确认记录"
      },
      "RepairHandleVO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "handlerId": {
            "type": "integer",
            "format": "int64"
          },
          "handlerName": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "处理记录"
      },
      "RepairOrderDetailVO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "报修单ID",
            "format": "int64"
          },
          "orderNo": {
            "type": "string",
            "description": "报修单号"
          },
          "reporterId": {
            "type": "integer",
            "description": "报障人ID",
            "format": "int64"
          },
          "reporterName": {
            "type": "string",
            "description": "报障人姓名（关联 sys_user）"
          },
          "deviceId": {
            "type": "integer",
            "description": "设备ID",
            "format": "int64"
          },
          "deviceName": {
            "type": "string",
            "description": "设备名称（关联 device）"
          },
          "roomName": {
            "type": "string",
            "description": "所在机房"
          },
          "faultDesc": {
            "type": "string",
            "description": "故障描述"
          },
          "priority": {
            "type": "string",
            "description": "优先级"
          },
          "status": {
            "type": "string",
            "description": "单据状态"
          },
          "statusLabel": {
            "type": "string",
            "description": "单据状态中文名"
          },
          "priorityLabel": {
            "type": "string",
            "description": "优先级中文名"
          },
          "createdAt": {
            "type": "string",
            "description": "提交时间",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "最后更新时间",
            "format": "date-time"
          },
          "statusLogs": {
            "type": "array",
            "description": "状态变更轨迹",
            "items": {
              "$ref": "#/components/schemas/StatusLogVO"
            }
          },
          "handles": {
            "type": "array",
            "description": "技术员处理记录",
            "items": {
              "$ref": "#/components/schemas/RepairHandleVO"
            }
