                }
              }
            }
          }
        }
      }
    },
    "/api/repair-orders/{id}/confirm": {
      "post": {
        "tags": [
          "报修单管理"
        ],
        "summary": "报障人验收：PASS 关闭工单 / FAIL 退回返工",
        "operationId": "confirm",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultRepairOrderDetailVO"
                }
              }
            }
          }
        }
      }
    },
    "/api/repair-orders/{id}/accept": {
      "post": {
        "tags": [
          "报修单管理"
        ],
        "summary": "受理报修单：待受理 -> 排查中",
        "operationId": "accept",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderActionDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultRepairOrderDetailVO"
                }
              }
            }
          }
        }
      }
    },
